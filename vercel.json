{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py?__path__=uploads/$1"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
